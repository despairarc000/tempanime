# Set these for the current department's Supabase project.
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Public origin for Supabase confirmation callback (no trailing slash).
# In local development use http://localhost:3000 and allowlist the callback.
# The deployment has a fixed department-specific public-domain fallback.
NEXT_PUBLIC_APP_URL=http://localhost:3000
